# ---------------------------------------------------------------------------
# Cria — public runtime env
#
# Copy to `.env.local` and fill in. Only EXPO_PUBLIC_* vars are inlined into
# the JS bundle, so NEVER put anything secret here: RevenueCat *public* SDK
# keys are safe to ship, its secret API key is not.
#
# `.env*.local` is gitignored. Never commit real keys.
# ---------------------------------------------------------------------------

# RevenueCat public SDK keys (RevenueCat dashboard > Project > API keys)
EXPO_PUBLIC_RC_IOS_API_KEY=appl_XXXXXXXXXXXXXXXXXXXXXXXXXX
EXPO_PUBLIC_RC_ANDROID_API_KEY=goog_XXXXXXXXXXXXXXXXXXXXXXXXXX

# Entitlement identifier that flips the app to "unlocked"
EXPO_PUBLIC_RC_ENTITLEMENT_ID=cria_pro

# Offering to show in the paywall. Leave empty to use the "current" offering.
EXPO_PUBLIC_RC_OFFERING_ID=default

# Non-consumable product id (single purchase). Informational / fallback only:
# the paywall reads packages from the offering above.
EXPO_PUBLIC_RC_PRODUCT_ID=com.kavicki.cria.desbloqueio

# Store ids used by the rating prompt deep links
EXPO_PUBLIC_IOS_APP_STORE_ID=0000000000
EXPO_PUBLIC_ANDROID_PACKAGE_NAME=com.kavicki.cria

# Support / about links shown in Settings
EXPO_PUBLIC_SUPPORT_EMAIL=design@kavicki.com
EXPO_PUBLIC_PRIVACY_URL=https://cria.kavicki.com/privacidade.html
EXPO_PUBLIC_TERMS_URL=https://cria.kavicki.com/termos.html

# development | preview | production (set per EAS build profile)
EXPO_PUBLIC_APP_ENV=development
