{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.22.0",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "design@kavicki.com",
        "EXPO_PUBLIC_ANDROID_PACKAGE_NAME": "com.kavicki.cria",
        "EXPO_PUBLIC_RC_ENTITLEMENT_ID": "cria_pro",
        "EXPO_PUBLIC_RC_OFFERING_ID": "default",
        "EXPO_PUBLIC_RC_PRODUCT_ID": "com.kavicki.cria.desbloqueio",
        "EXPO_PUBLIC_PRIVACY_URL": "https://cria.kavicki.com/privacidade.html",
        "EXPO_PUBLIC_TERMS_URL": "https://cria.kavicki.com/termos.html"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false,
        "buildConfiguration": "Debug"
      }
    },
    "development-sim": {
      "extends": "development",
      "ios": {
        "simulator": true,
        "buildConfiguration": "Debug"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "preview"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      }
    }
  },
  "submit": {
    "production": {}
  }
}
